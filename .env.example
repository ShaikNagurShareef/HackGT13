# Copy to backend/.env and fill in. Never commit the real file.

# --- LLM explanations (Grok first when set, then Groq, Gemini, template last) ---
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Voice (P1): Grok voice first when XAI_API_KEY is set, then ElevenLabs, then device ---
XAI_TTS_VOICE=eve
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Grok Imagine street redesign illustrations (uses XAI_API_KEY; hidden without it) ---
XAI_IMAGE_MODEL=grok-imagine-image-2.0
IMAGINE_DAILY_BUDGET=40
IMAGINE_PER_CLIENT_DAILY=10

# --- Geocoding autocomplete ---
GEOAPIFY_API_KEY=

# --- Tiger Data (Postgres + TimescaleDB + PostGIS); optional for the demo path ---
DATABASE_URL=

# --- MongoDB Atlas (community street reports); optional, the feature hides without it ---
MONGODB_URI=
MONGODB_DB=pathpulse

# --- App ---
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ARTIFACTS_DIR=../artifacts/current
RATE_LIMIT_PER_MINUTE=60

# --- Deploy (M6) ---
VULTR_API_KEY=
