# Copy to backend/.env and fill in. Never commit the real file.

# --- LLM explanations (Groq primary, Gemini fallback, template last) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Voice (P1) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Geocoding autocomplete ---
GEOAPIFY_API_KEY=

# --- Tiger Data (Postgres + TimescaleDB + PostGIS); optional for the demo path ---
DATABASE_URL=

# --- MongoDB Atlas (community street reports); optional, the feature hides without it ---
MONGODB_URI=
MONGODB_DB=pathpulse

# --- App ---
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ARTIFACTS_DIR=../artifacts/current
RATE_LIMIT_PER_MINUTE=60

# --- Deploy (M6) ---
VULTR_API_KEY=
