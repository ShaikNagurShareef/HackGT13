[Unit]
Description=PathPro API (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pathpulse
Group=pathpulse
WorkingDirectory=/srv/pathpulse/app/backend
EnvironmentFile=/srv/pathpulse/app/backend/.env
Environment=APP_ENV=production
Environment=ARTIFACTS_DIR=/srv/pathpulse/artifacts/current
# libpq probes ~/.postgresql for client certs; with ProtectHome=true /home is unreadable and the
# probe fails the connection. A HOME outside /home keeps the hardening and lets Tiger connect.
Environment=HOME=/srv/pathpulse
# No uvicorn access log: it would record query strings (lat/lon, bbox, search text); Caddy keeps a filtered log (NFR-09).
ExecStart=/srv/pathpulse/app/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=2

# Hardening: the API only reads its code and artifacts. Its one writable path is the Grok Imagine
# image cache, which systemd creates as /var/cache/pathpulse-imagine, owned by the service user.
CacheDirectory=pathpulse-imagine
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/pathpulse
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
