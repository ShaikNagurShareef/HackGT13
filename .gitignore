# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/

# Secrets
.env
.env.*
!.env.example

# Data: raw pulls are re-fetchable; cleaned snapshots in data/interim are committed
data/raw/
data/cache/
*.graphml
*.pkl

# Model artifacts: only the pinned demo bundle is committed
artifacts/*
!artifacts/.gitkeep
!artifacts/demo/

# OS / editor
.DS_Store
.idea/
*.swp

# Claude Code local-only state
.claude/settings.local.json
.claude/checkpoints.log

# OSMnx HTTP cache and reproducible intermediates
cache/
data/interim/

# Deploy state
deploy/.host
deploy/.tunnel_url

# Demo geometry/frames are regenerated by backend/app/tools/record_demo.py (too large for git)
frontend/public/demo/static/
deploy/.ghpages/

# Demo video renders and review stills (script and thumbnail are committed)
media/*.mp4
# Final demo videos are committed through Git LFS (see .gitattributes).
!media/pathpro_demo_v2.mp4
!media/pathpro_30s.mp4
media/raw/
